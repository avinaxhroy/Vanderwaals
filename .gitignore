# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
.gradle/
.externalNativeBuild/
.cxx/

# Local configuration file (sdk.dir is not checked in)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
misc.xml
deployment.xml
modules.xml
settings.xml
vcs.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Python
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.env
.venv
env/
venv/

# System
.DS_Store
Thumbs.db


# Scripts
scripts/.DS_Store

# Lock files
*.lock

# Release builds
/app/release
app/release/output-metadata.json

# Build logs and model conversion artifacts (regenerable via scripts/)
build_output.txt
model_conversion_output/

# Manifest files (managed by GitHub Actions, not synced locally)
# GitHub Actions uses 'git add -f' to force-commit these despite being ignored
app/src/main/assets/manifest_v2.json
app/src/main/assets/manifest_v2.json.gz
app/src/main/assets/manifest.json
app/src/main/assets/manifest.json.gz
app/src/main/assets/bing_manifest_lite.json
app/src/main/assets/bing_manifest_lite.json.gz
app/src/main/assets/bing_manifest_full.json
app/src/main/assets/bing_manifest_full.json.gz

# Generic local & private developer files
*.local
*.local.*
*.private
/private/
/scratch/

