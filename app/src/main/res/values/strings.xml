  <string name="privacy_intro_title">Introduction</string>
  <string name="privacy_intro_content">Welcome to %1$s. This privacy policy explains how data is handled on your device. Vanderwaals is built with an offline-first architecture—no personal data is ever collected or uploaded.</string>
  <string name="privacy_data_collection_title">Data Collection</string>
  <string name="privacy_data_collection_content">Notifications: %1$s requests notification access to alert you when wallpapers update in the background. We never read or inspect notification contents.\n\nLocal Files: %1$s reads local images only when you select them as wallpapers or style references. No files are uploaded to any external server.</string>
  <string name="privacy_information_usage_title">Information Usage</string>
  <string name="privacy_information_usage_content">Personal Data: We do not collect or store personal data such as names, email addresses, or phone numbers.\n\nUsage Analytics: %1$s does not track your usage behavior or include analytics SDKs.</string>
  <string name="privacy_data_security_title">Data Security</string>
  <string name="privacy_data_security_content">On-Device Storage: All preference embeddings, history, and cached images stay on your device. We do not transmit or store your preferences externally.</string>
  <string name="privacy_third_party_services_title">Third-Party Services</string>
  <string name="privacy_third_party_services_content">Advertisements: %1$s contains no ads or tracking libraries.\n\nExternal Links: The app links to our GitHub repository and open-source catalogs.</string>
  <string name="privacy_children_privacy_title">Children’s Privacy</string>
  <string name="privacy_children_privacy_content">%1$s is a utility app and is not directed at children under 13. We do not collect information from anyone.</string>
  <string name="privacy_changes_notice_title">Changes to This Policy</string>
  <string name="privacy_changes_notice_content">Any updates to this policy will be reflected in app releases and on the open-source repository.</string>
  <string name="privacy_contact_us_title">Contact Us</string>
  <string name="privacy_contact_us_content">If you have questions about this privacy notice, contact us at %1$s.</string>
